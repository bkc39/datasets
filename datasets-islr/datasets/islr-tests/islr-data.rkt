#lang racket/base
(require (for-syntax racket/base)
         (only-in datasets/core dataset-info dataset-missing dataset-missing? dataset-names
                  dataset-packages dataset-table-column dataset-table-columns dataset-table-names
                  dataset-table-row-count load-dataset-table)
         (only-in datasets/core-tests/fixture gunzip-file hex)
         (only-in racket/match match match-define)
         (only-in racket/runtime-path define-runtime-path)
         (only-in racket/vector vector-count)
         (only-in setup/getinfo get-info/full))
(define-runtime-path islr-data "../islr-data")
(define-runtime-path package-root "../..")
(module+ test
  (require (only-in rackunit check-= check-equal? check-false check-not-false check-regexp-match
                    check-true))
  (define shapes
    '((auto 392 9) (bikeshare 8645 15) (boston 506 13) (brain-cancer 88 8) (caravan 5822 86)
      (carseats 400 11) (college 777 19) (credit 400 11) (default 10000 4) (fund 50 2000)
      (hitters 322 21) (khan 83 2310) (nci60 64 6831) (nyse 6051 6) (oj 1070 18)
      (portfolio 100 2) (publication 244 9) (smarket 1250 9) (wage 3000 11) (weekly 1089 9)))
  (define ids (map car shapes))
  (define (data-file id) (build-path islr-data "data" (format "~a.rktd.gz" id)))
  (define (column id name) (dataset-table-column (load-dataset-table id) name))
  (define (column-meta id name key)
    (for/first ([meta (in-list (hash-ref (dataset-info id) "columns"))]
                #:when (equal? (hash-ref meta "name") name))
      (hash-ref meta key)))
  (define (column-count id name keep?) (vector-count keep? (column id name)))
  (define (value-counts id name values)
    (for/list ([value (in-list values)]) (column-count id name (lambda (v) (equal? v value)))))
  (define (column-sum id name)
    (for/sum ([v (in-vector (column id name))] #:unless (dataset-missing? v)) v))
  (define (typed-columns id type)
    (for/list ([meta (in-list (hash-ref (dataset-info id) "columns"))]
               #:when (equal? (hash-ref meta "type") type))
      (hash-ref meta "name")))
  (define (column-type name levels identifiers present)
    (cond
      [(member name identifiers) "identifier"]
      [(pair? levels) "categorical"]
      [(andmap exact-integer? present) "integer"]
      [(andmap real? present) "real"]
      [else "string"]))
  (define spot-checks
    `((names auto ("mpg" "cylinders" "displacement" "horsepower" "weight" "acceleration" "year"
                   "origin" "name"))
      (row auto 0 ("mpg" "name") (18 "chevrolet chevelle malibu"))
      (row auto 391 ("horsepower") (82))
      (sum auto "mpg" 9190.8 1e-9)
      (meta-length auto "name" "levels" 304)
      (categorical auto ("name"))
      (row bikeshare 0 ("mnth" "hr" "weathersit") ("Jan" "0" "clear"))
      (sum bikeshare "bikers" 1243103)
      (level-counts bikeshare "weathersit" (5645 2218 781 1))
      (meta bikeshare "mnth" "levels" ("Jan" "Feb" "March" "April" "May" "June" "July" "Aug"
                                       "Sept" "Oct" "Nov" "Dec"))
      (meta-length bikeshare "hr" "levels" 24)
      (categorical bikeshare ("mnth" "hr" "weathersit"))
      (names boston ("crim" "zn" "indus" "chas" "nox" "rm" "age" "dis" "rad" "tax" "ptratio"
                     "lstat" "medv"))
      (row boston 0 ("crim" "medv") (0.00632 24))
      (sum boston "medv" 11401.6 1e-9)
      (row brain-cancer 0 ("sex" "diagnosis") ("Female" "Meningioma"))
      (missing brain-cancer ("diagnosis" "time") (1 0))
      (level-counts brain-cancer "diagnosis" (42 9 22 14))
      (sum brain-cancer "status" 35)
      (info brain-cancer "suggested-targets" ("time" "status"))
      (level-counts caravan "purchase" (5474 348))
      (sum caravan "mostype" 141203)
      (meta caravan "mostype" "original-name" "MOSTYPE")
      (categorical caravan ("purchase"))
      (sum carseats "sales" 2998.53 1e-9)
      (level-counts carseats "shelve-loc" (96 85 219))
      (meta carseats "comp-price" "original-name" "CompPrice")
      (row college 0 ("name" "private" "apps") ("Abilene Christian University" "Yes" 1660))
      (sum college "apps" 2332273)
      (level-counts college "private" (212 565))
      (meta college "f-undergrad" "original-name" "F.Undergrad")
      (meta college "name" "original-name" "row names")
      (identifiers college ("name"))
      (sum credit "balance" 208006)
      (level-counts credit "region" (99 199 102))
      (categorical credit ("own" "student" "married" "region"))
      (names default ("default" "student" "balance" "income"))
      (level-counts default "default" (9667 333))
      (sum default "balance" 8353748.8561255708 1e-6)
      (info default "suggested-targets" ("default"))
      (row fund 0 ("manager1") (-3.3419922473964618))
      (row fund 49 ("manager2000") (6.6802416575816315))
      (sum fund "manager1" 150 1e-9)
      (info fund "suggested-targets" ())
      (row hitters 1 ("player" "salary" "c-at-bat") ("-Alan Ashby" 475 3449))
      (row hitters 0 ("salary") (,dataset-missing))
      (missing hitters ("salary" "at-bat") (59 0))
      (sum hitters "salary" 140948.507 1e-6)
      (meta hitters "c-at-bat" "original-name" "CAtBat")
      (meta hitters "player" "original-name" "row names")
      (identifiers hitters ("player"))
      (categorical hitters ("league" "division" "new-league"))
      (info hitters "suggested-targets" ("salary"))
      (row khan 0 ("split" "y" "gene-1") ("train" 2 0.7733437))
      (row khan 82 ("split" "gene-2308") ("test" -1.273322882))
      (level-counts khan "split" (63 20))
      (value-counts khan "y" (1 2 3 4) (11 29 18 25))
      (sum khan "y" 223)
      (meta khan "gene-2308" "original-name" "2308")
      (categorical khan ("split"))
      (row nci60 0 ("label" "gene-1") ("CNS" 0.3))
      (row nci60 63 ("label" "gene-6830") ("MELANOMA" 1.21))
      (level-counts nci60 "label" (7 5 7 1 1 6 1 1 8 9 6 2 9 1))
      (meta nci60 "label" "original-name" "labs")
      (categorical nci60 ("label"))
      (info nci60 "suggested-targets" ())
      (row nyse 0 ("date" "day-of-week" "train" "log-volume") ("1962-12-03" "mon" 1 0.032573))
      (row nyse 6050 ("date" "train") ("1986-12-31" 0))
      (sum nyse "train" 4281)
      (meta nyse "day-of-week" "levels" ("mon" "tues" "wed" "thur" "fri"))
      (meta nyse "dj-return" "original-name" "DJ_return")
      (categorical nyse ("day-of-week"))
      (level-counts oj "purchase" (653 417))
      (sum oj "price-ch" 1998.14 1e-9)
      (meta oj "weekof-purchase" "original-name" "WeekofPurchase")
      (row portfolio 99 ("y") (-0.49728509081785577))
      (sum portfolio "x" -7.7132108210991772 1e-9)
      (sum publication "sampsize" 488140)
      (meta-length publication "mech" "levels" 14)
      (value-counts publication "mech" ("R01" "Contract") (147 20))
      (row smarket 0 ("year" "volume" "direction") (2001 1.1913 "Up"))
      (level-counts smarket "direction" (602 648))
      (sum wage "wage" 335110.82460523036 1e-6)
      (level-counts wage "education" (268 971 650 685 426))
      (meta-length wage "region" "levels" 9)
      (categorical wage ("maritl" "race" "education" "region" "jobclass" "health" "health-ins"))
      (level-counts weekly "direction" (484 605))
      (row weekly 1088 ("today") (0.069))))

  (check-equal? (dataset-names #:package "datasets-islr") ids)
  (check-not-false (member "datasets-islr" (dataset-packages)))
  (for ([shape (in-list shapes)])
    (match-define (list id rows cols) shape)
    (define t (load-dataset-table id))
    (define info (dataset-info id))
    (check-equal? (dataset-table-row-count t) rows)
    (check-equal? (length (dataset-table-names t)) cols)
    (check-equal? (hash-ref info "rows") rows)
    (check-equal? (hash-ref info "column-count") cols)
    (check-equal? (hash-ref info "tier") "bundled")
    (check-equal? (hash-ref info "package") "datasets-islr")
    (check-false (hash-ref info "fetch"))
    (check-equal? (hash-ref info "license") "GPL-2.0-only")
    (check-equal? (hash-ref info "source-version") "ISLR2 1.3-2")
    (check-regexp-match #rx"ISLR2 use: " (hash-ref info "notes"))
    (check-equal? (hex (sha256-bytes (gunzip-file (data-file id)))) (hash-ref info "sha256"))
    (define header (call-with-input-file (data-file id) (lambda (in) (read-bytes 8 in))))
    (check-equal? (subbytes header 0 4) (bytes #x1f #x8b 8 0))
    (check-equal? (subbytes header 4 8) (bytes 0 0 0 0))
    (check-true (file-exists? (build-path islr-data "provenance" (format "~a.Rd" id))))
    (for ([target (in-list (hash-ref info "suggested-targets"))])
      (check-not-false (member target (dataset-table-names t)) target))
    (for ([c (in-vector (dataset-table-columns t))] [meta (in-list (hash-ref info "columns"))])
      (define name (hash-ref meta "name"))
      (define present (for/list ([v (in-vector c)] #:unless (dataset-missing? v)) v))
      (define levels (hash-ref meta "levels"))
      (check-equal? (vector-length c) rows)
      (check-equal? (vector-count dataset-missing? c) (hash-ref meta "missing-count") name)
      (check-equal? (hash-ref meta "type")
                    (column-type name levels (hash-ref info "identifiers") present)
                    name)
      (check-true (or (null? levels) (andmap (lambda (v) (and (member v levels) #t)) present))
                  name)))
  (check-equal? (sort (map path->string (directory-list (build-path islr-data "data"))) string<?)
                (sort (for/list ([id (in-list ids)]) (format "~a.rktd.gz" id)) string<?))
  (match-define (list _ 'AND data-license) ((get-info/full package-root) 'license))
  (check-equal? data-license 'GPL-2.0-only)
  (check-true (file-exists? (build-path islr-data "licenses" "GPL-2.0-only.txt")))

  (for ([spot (in-list spot-checks)])
    (match spot
      [(list 'names id expected) (check-equal? (dataset-table-names (load-dataset-table id)) expected)]
      [(list 'row id row names expected)
       (check-equal? (for/list ([name (in-list names)]) (vector-ref (column id name) row)) expected)]
      [(list 'missing id names expected)
       (check-equal? (for/list ([name (in-list names)]) (column-count id name dataset-missing?))
                     expected)]
      [(list 'sum id name expected) (check-equal? (column-sum id name) expected)]
      [(list 'sum id name expected epsilon) (check-= (column-sum id name) expected epsilon)]
      [(list 'level-counts id name expected)
       (check-equal? (value-counts id name (column-meta id name "levels")) expected)]
      [(list 'value-counts id name values expected)
       (check-equal? (value-counts id name values) expected)]
      [(list 'categorical id expected) (check-equal? (typed-columns id "categorical") expected)]
      [(list 'identifiers id expected)
       (check-equal? (hash-ref (dataset-info id) "identifiers") expected)
       (check-equal? (typed-columns id "identifier") expected)]
      [(list 'meta id name key expected) (check-equal? (column-meta id name key) expected)]
      [(list 'meta-length id name key expected)
       (check-equal? (length (column-meta id name key)) expected)]
      [(list 'info id key expected) (check-equal? (hash-ref (dataset-info id) key) expected)])))
