#lang racket/base
(require (only-in datasets/core dataset-info)
         (only-in datasets/core-doc/catalog-rows catalog-column-rows))
(module+ test
  (require (only-in rackunit check-equal?))
  (define (column name original type [description original] #:unit [unit #f] #:levels [levels '()])
    (hash "name" name "original-name" original "type" type "unit" unit "levels" levels
          "description" description))
  (define (genes from to)
    (for/list ([i (in-range from (add1 to))])
      (column (format "gene-~a" i) (number->string i) "real")))

  (check-equal? (catalog-column-rows (cons (column "label" "labs" "categorical") (genes 1 2308)))
                '(("label" "labs" "categorical" "labs; #f; ()")
                  ("gene-1 … gene-2308" "1 … 2308" "real" "1 … 2308; #f; ()")))
  (check-equal? (catalog-column-rows
                 (for/list ([i (in-range 1 4)])
                   (column (format "manager~a" i) (format "Manager~a" i) "real" "Monthly return")))
                '(("manager1 … manager3" "Manager1 … Manager3" "real" "Monthly return; #f; ()")))
  (check-equal? (catalog-column-rows
                 (list (column "lag1" "Lag1" "real" "Return for previous day")
                       (column "lag2" "Lag2" "real" "Return for 2 days previous")
                       (column "lag3" "Lag3" "real" "Return for 3 days previous")))
                '(("lag1" "Lag1" "real" "Return for previous day; #f; ()")
                  ("lag2" "Lag2" "real" "Return for 2 days previous; #f; ()")
                  ("lag3" "Lag3" "real" "Return for 3 days previous; #f; ()")))
  (check-equal? (catalog-column-rows (append (genes 1 2) (list (column "gene-4" "4" "real"))))
                '(("gene-1" "1" "real" "1; #f; ()") ("gene-2" "2" "real" "2; #f; ()")
                  ("gene-4" "4" "real" "4; #f; ()")))
  (check-equal? (catalog-column-rows (append (genes 1 3) (list (column "gene-4" "4" "integer"))))
                '(("gene-1 … gene-3" "1 … 3" "real" "1 … 3; #f; ()")
                  ("gene-4" "4" "integer" "4; #f; ()")))
  (check-equal? (catalog-column-rows (list (column "maut1" "MAUT1" "integer")
                                           (column "maut2" "MAUT2" "integer")
                                           (column "maut0" "MAUT0" "integer")))
                '(("maut1" "MAUT1" "integer" "MAUT1; #f; ()")
                  ("maut2" "MAUT2" "integer" "MAUT2; #f; ()")
                  ("maut0" "MAUT0" "integer" "MAUT0; #f; ()")))
  (check-equal? (catalog-column-rows (for/list ([name (in-list '("q1" "q2" "q3"))]
                                                 [original (in-list '("Q1" "Score" "Q3"))])
                                       (column name original "real" "Quiz mark")))
                '(("q1" "Q1" "real" "Quiz mark; #f; ()")
                  ("q2" "Score" "real" "Quiz mark; #f; ()")
                  ("q3" "Q3" "real" "Quiz mark; #f; ()")))
  (check-equal? (catalog-column-rows (list (column "x1" "x1" "real")
                                           (column "x2" "x2" "real" #:unit "cm")
                                           (column "x3" "x3" "real")))
                '(("x1" "x1" "real" "x1; #f; ()")
                  ("x2" "x2" "real" "x2; cm; ()")
                  ("x3" "x3" "real" "x3; #f; ()")))
  (check-equal? (catalog-column-rows (list (column "c1" "c1" "categorical" #:levels '("a" "b"))
                                           (column "c2" "c2" "categorical" #:levels '("a"))
                                           (column "c3" "c3" "categorical" #:levels '("a" "b"))))
                '(("c1" "c1" "categorical" "c1; #f; (a b)")
                  ("c2" "c2" "categorical" "c2; #f; (a)")
                  ("c3" "c3" "categorical" "c3; #f; (a b)")))
  (check-equal? (catalog-column-rows (for/list ([name (in-list '("x09" "x10" "x11"))])
                                       (column name name "real")))
                '(("x09 … x11" "x09 … x11" "real" "x09 … x11; #f; ()")))
  (check-equal? (catalog-column-rows (genes 5 7))
                '(("gene-5 … gene-7" "5 … 7" "real" "5 … 7; #f; ()")))
  (check-equal? (catalog-column-rows (hash-ref (dataset-info 'anscombe) "columns"))
                '(("x1 … x4" "x1 … x4" "integer" "x1 … x4; #f; ()")
                  ("y1 … y4" "y1 … y4" "real" "y1 … y4; #f; ()"))))
