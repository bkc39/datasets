#lang racket/base
(require (for-syntax racket/base)
         (only-in datasets/core dataset-info dataset-missing dataset-table-names
                  dataset-table-row-count load-dataset-table)
         (only-in racket/file file->lines file->value)
         (only-in racket/hash hash-union)
         (only-in racket/list make-list)
         (only-in racket/match match-define)
         (only-in racket/runtime-path define-runtime-path))
(define-runtime-path r-data "../r-data")
(define-runtime-path ggplot2-spots-file "ggplot2-spots.rktd")
(module+ test
  (require (only-in (submod datasets/core-tests/registry-checks test) check-bundled-registry)
           (only-in rackunit check-equal? check-not-false)
           (only-in (submod "spot.rkt" test) check-spot ggplot2-ids r-dataset-ids))
  (define penguins-names
    '("species" "island" "bill-length-mm" "bill-depth-mm" "flipper-length-mm" "body-mass-g" "sex"
      "year"))
  (define gapminder-names '("country" "continent" "year" "life-exp" "pop" "gdp-percap"))
  (define datasaurus-names '("dataset" "x" "y"))
  (define titanic-names
    '("passenger-id" "survived" "pclass" "name" "sex" "age" "sib-sp" "parch" "ticket" "fare" "cabin"
      "embarked"))
  (define airlines-names '("carrier" "name"))
  (define airports-names '("faa" "name" "lat" "lon" "alt" "tz" "dst" "tzone"))
  (define planes-names
    '("tailnum" "year" "type" "manufacturer" "model" "engines" "seats" "speed" "engine"))
  (define weather-names
    '("origin" "year" "month" "day" "hour" "temp" "dewp" "humid" "wind-dir" "wind-speed" "wind-gust"
      "precip" "pressure" "visib" "time-hour"))
  (define weather-keys '("origin" "month" "day" "hour" "time-hour"))
  (define shapes
    `((datasaurus-dozen 1846 ,datasaurus-names)
      (gapminder 1704 ,gapminder-names)
      (nycflights13-airlines 16 ,airlines-names)
      (nycflights13-airports 1458 ,airports-names)
      (nycflights13-planes 3322 ,planes-names)
      (nycflights13-weather 26115 ,weather-names)
      (penguins 344 ,penguins-names)
      (penguins-raw 344 ("study-name" "sample-number" "species" "region" "island" "stage"
                         "individual-id" "clutch-completion" "date-egg" "culmen-length-mm"
                         "culmen-depth-mm" "flipper-length-mm" "body-mass-g" "sex"
                         "delta-15-n" "delta-13-c" "comments"))
      (titanic-passengers 891 ,titanic-names)))
  (define ggplot2-spots (file->value ggplot2-spots-file))
  (define licenses
    (hash-union (for/hash ([id (in-list '(gapminder nycflights13-airlines nycflights13-airports
                                                    nycflights13-planes nycflights13-weather penguins
                                                    penguins-raw titanic-passengers))])
                  (values id "CC0-1.0"))
                (for/hash ([id (in-list (cons 'datasaurus-dozen ggplot2-ids))])
                  (values id "MIT"))))
  (define ids (sort (append (map car shapes) ggplot2-ids r-dataset-ids) symbol<?))
  (define (key-values lines)
    (for*/hash ([line (in-list lines)]
                [pair (in-value (regexp-match #px"^([^:]+): (.*)$" line))]
                #:when pair)
      (match-define (list _ key value) pair)
      (values key value)))
  (define spot-checks
    `((categorical datasaurus-dozen ("dataset"))
      (categorical gapminder ("country" "continent"))
      (categorical penguins ("species" "island" "sex"))
      (categorical penguins-raw
                   ("study-name" "species" "region" "island" "stage" "clutch-completion" "sex"))
      (categorical titanic-passengers ("sex" "embarked"))
      (identifiers datasaurus-dozen ())
      (identifiers gapminder ())
      (identifiers penguins ())
      (identifiers penguins-raw ())
      (identifiers titanic-passengers ("passenger-id"))
      (types penguins ("bill-length-mm" "real") ("bill-depth-mm" "real")
             ("flipper-length-mm" "integer") ("body-mass-g" "integer") ("year" "integer"))
      (types penguins-raw ("sample-number" "real") ("culmen-length-mm" "real")
             ("flipper-length-mm" "real") ("body-mass-g" "real"))
      (types titanic-passengers ("passenger-id" "identifier") ("survived" "integer")
             ("pclass" "integer") ("age" "real") ("sib-sp" "integer") ("parch" "integer")
             ("fare" "real"))
      (row penguins 0 ,penguins-names ("Adelie" "Torgersen" 39.1 18.7 181 3750 "male" 2007))
      (row penguins 3 ("bill-length-mm" "bill-depth-mm" "flipper-length-mm" "body-mass-g" "sex")
           ,(make-list 5 dataset-missing))
      (row penguins 343 ("species" "bill-length-mm") ("Chinstrap" 50.2))
      (missing penguins ("bill-length-mm" "sex") (2 11))
      (sum penguins "body-mass-g" 1437000)
      (level-counts penguins "species" (152 68 124))
      (meta penguins "species" "levels" ("Adelie" "Chinstrap" "Gentoo"))
      (info penguins "suggested-targets" ("species"))
      (row penguins-raw 0 ("study-name" "date-egg" "comments")
           ("PAL0708" "2007-11-11" "Not enough blood for isotopes."))
      (row penguins-raw 1 ("delta-15-n" "delta-13-c") (8.94956 -24.69454))
      (row penguins-raw 343 ("individual-id" "species")
           ("N100A2" "Chinstrap penguin (Pygoscelis antarctica)"))
      (missing penguins-raw ("delta-15-n" "delta-13-c" "comments") (14 13 290))
      (meta penguins-raw "delta-15-n" "original-name" "Delta 15 N (o/oo)")
      (meta penguins-raw "study-name" "type" "categorical")
      (meta penguins-raw "study-name" "levels" ("PAL0708" "PAL0809" "PAL0910"))
      (row gapminder 0 ,gapminder-names ("Afghanistan" "Asia" 1952 28.801 8425333 779.4453145))
      (row gapminder 1703 ,gapminder-names ("Zimbabwe" "Africa" 2007 43.487 12311143 469.7092981))
      (sum gapminder "pop" 50440465801)
      (level-counts gapminder "country" ,(make-list 142 12))
      (meta gapminder "continent" "levels" ("Africa" "Americas" "Asia" "Europe" "Oceania"))
      (info gapminder "suggested-targets" ("life-exp"))
      (row datasaurus-dozen 0 ,datasaurus-names ("dino" 55.3846 97.1795))
      (row datasaurus-dozen 1845 ,datasaurus-names ("wide_lines" 34.5838289299 89.5889019877))
      (sum datasaurus-dozen "x" 100174.47351619641 1e-6)
      (level-counts datasaurus-dozen "dataset" ,(make-list 13 142))
      (info-match datasaurus-dozen "citation"
                  #rx"^Gillespie, C\\., Locke, S\\., Davies, R\\. and D'Agostino McGowan, L\\. \\(2025\\)")
      (row titanic-passengers 0 ,titanic-names
           (1 0 3 "Braund, Mr. Owen Harris" "male" 22.0 1 0 "A/5 21171" 7.25 ,dataset-missing "S"))
      (row titanic-passengers 1 ("cabin" "fare") ("C85" 71.2833))
      (row titanic-passengers 890 ("name" "ticket") ("Dooley, Mr. Patrick" "370376"))
      (missing titanic-passengers ("age" "cabin" "embarked") (177 687 2))
      (sum titanic-passengers "survived" 342)
      (sum titanic-passengers "fare" 28693.9493 1e-6)
      (info titanic-passengers "suggested-targets" ("survived"))
      (meta titanic-passengers "passenger-id" "original-name" "PassengerId")
      (identifiers nycflights13-airlines ("carrier"))
      (identifiers nycflights13-airports ("faa"))
      (identifiers nycflights13-planes ("tailnum"))
      (identifiers nycflights13-weather ())
      (row nycflights13-airlines 0 ,airlines-names ("9E" "Endeavor Air Inc."))
      (row nycflights13-airlines 15 ,airlines-names ("YV" "Mesa Airlines Inc."))
      (row nycflights13-airports 0 ,airports-names
           ("04G" "Lansdowne Airport" 41.1304722 -80.6195833 1044.0 -5.0 "A" "America/New_York"))
      (missing nycflights13-airports ("tzone") (3))
      (sum nycflights13-airports "alt" 1460064.0)
      (row nycflights13-planes 0 ("tailnum" "year" "engines" "seats" "speed" "engine")
           ("N10156" 2004 2 55 ,dataset-missing "Turbo-fan"))
      (missing nycflights13-planes ("year" "speed") (70 3299))
      (sum nycflights13-planes "seats" 512639)
      (row nycflights13-weather 0 ,weather-names
           ("EWR" 2013 1 1 1 39.02 26.06 59.37 270.0 10.357019999999999 ,dataset-missing 0.0 1012.0 10.0
                  "2013-01-01T06:00:00Z"))
      (row nycflights13-weather 26114 ,weather-keys
           ("LGA" 12 30 18 "2013-12-30T23:00:00Z"))
      (row nycflights13-weather 4338 ,weather-keys
           ("EWR" 7 1 0 "2013-07-01T04:00:00Z"))
      (row nycflights13-weather 7318 ,weather-keys
           ("EWR" 11 3 1 "2013-11-03T05:00:00Z"))
      (row nycflights13-weather 7319 ,weather-keys
           ("EWR" 11 3 1 "2013-11-03T06:00:00Z"))
      (missing nycflights13-weather ("temp" "wind-dir" "wind-gust" "pressure") (1 460 20778 2729))
      (sum nycflights13-weather "precip" 116.71 1e-9)
      (meta nycflights13-weather "time-hour" "original-name" "time_hour")
      (info nycflights13-weather "source-version" "nycflights13 1.0.2")))

  (check-bundled-registry "datasets-r" r-data ids)
  (for ([shape (in-list shapes)])
    (match-define (list id rows names) shape)
    (define t (load-dataset-table id))
    (check-equal? (dataset-table-row-count t) rows)
    (check-equal? (dataset-table-names t) names))
  (for ([(id license) (in-hash licenses)])
    (check-equal? (hash-ref (dataset-info id) "license") license (symbol->string id)))
  (check-equal? (key-values '("YEAR: 2022" "" "no separator" "COPYRIGHT HOLDER: someone"))
                (hash "YEAR" "2022" "COPYRIGHT HOLDER" "someone"))
  (for ([upstream (in-list '("datasauRus-LICENSE" "ggplot2-LICENSE"))])
    (define copyright (key-values (file->lines (build-path r-data "provenance" upstream))))
    (check-not-false (member (format "Copyright (c) ~a ~a" (hash-ref copyright "YEAR")
                                     (hash-ref copyright "COPYRIGHT HOLDER"))
                             (file->lines (build-path r-data "licenses" "MIT.txt")))
                     upstream))

  (for-each check-spot (append spot-checks ggplot2-spots)))
