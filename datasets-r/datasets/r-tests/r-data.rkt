#lang racket/base
(require (for-syntax racket/base)
         (only-in racket/list remove-duplicates)
         (only-in racket/match match-define)
         (only-in racket/runtime-path define-runtime-path)
         datasets/core
         (only-in datasets/core-tests/fixture gunzip-file hex))
(define-runtime-path r-data "../r-data")
(module+ test
  (require rackunit)
  (define shapes
    '((datasaurus-dozen 1846 ("dataset" "x" "y"))
      (gapminder 1704 ("country" "continent" "year" "life-exp" "pop" "gdp-percap"))
      (penguins 344 ("species" "island" "bill-length-mm" "bill-depth-mm"
                     "flipper-length-mm" "body-mass-g" "sex" "year"))
      (penguins-raw 344 ("study-name" "sample-number" "species" "region" "island" "stage"
                         "individual-id" "clutch-completion" "date-egg" "culmen-length-mm"
                         "culmen-depth-mm" "flipper-length-mm" "body-mass-g" "sex"
                         "delta-15-n" "delta-13-c" "comments"))
      (titanic-passengers 891 ("passenger-id" "survived" "pclass" "name" "sex" "age" "sib-sp"
                               "parch" "ticket" "fare" "cabin" "embarked"))))
  (define licenses
    (hash 'datasaurus-dozen "MIT" 'gapminder "CC0-1.0" 'penguins "CC0-1.0"
          'penguins-raw "CC0-1.0" 'titanic-passengers "CC0-1.0"))
  (define (data-file id) (build-path r-data "data" (format "~a.rktd.gz" id)))
  (define (column id name) (dataset-table-column (load-dataset-table id) name))
  (define (cell id name row) (vector-ref (column id name) row))
  (define (column-meta id name key)
    (hash-ref (findf (lambda (c) (equal? (hash-ref c "name") name))
                     (hash-ref (dataset-info id) "columns"))
              key))
  (define (missing-count id name)
    (for/sum ([v (in-vector (column id name))]) (if (dataset-missing? v) 1 0)))

  (check-equal? (dataset-names #:package "datasets-r") (map car shapes))
  (check-not-false (member "datasets-r" (dataset-packages)))
  (for ([shape (in-list shapes)])
    (match-define (list id rows names) shape)
    (define t (load-dataset-table id))
    (define info (dataset-info id))
    (check-equal? (dataset-table-row-count t) rows)
    (check-equal? (dataset-table-names t) names)
    (check-equal? (hash-ref info "rows") rows)
    (check-equal? (hash-ref info "column-count") (length names))
    (check-equal? (hash-ref info "tier") "bundled")
    (check-equal? (hash-ref info "package") "datasets-r")
    (check-false (hash-ref info "fetch"))
    (check-equal? (hash-ref info "license") (hash-ref licenses id))
    (check-equal? (hex (sha256-bytes (gunzip-file (data-file id)))) (hash-ref info "sha256"))
    (define header (call-with-input-file (data-file id) (lambda (in) (read-bytes 8 in))))
    (check-equal? (subbytes header 0 4) (bytes #x1f #x8b 8 0))
    (check-equal? (subbytes header 4 8) (bytes 0 0 0 0))
    (check-true (immutable? info))
    (for ([c (in-vector (dataset-table-columns t))] [meta (in-list (hash-ref info "columns"))])
      (check-true (immutable? c))
      (check-equal? (vector-length c) rows)
      (check-equal? (for/sum ([v (in-vector c)]) (if (dataset-missing? v) 1 0))
                    (hash-ref meta "missing-count")))
    (for ([c (in-vector (dataset-table-columns t))] [meta (in-list (hash-ref info "columns"))]
          #:when (pair? (hash-ref meta "levels")))
      (check-equal? (sort (remove-duplicates
                           (for/list ([v (in-vector c)] #:unless (dataset-missing? v)) v))
                          string<?)
                    (sort (hash-ref meta "levels") string<?))))
  (check-equal? (sort (map path->string (directory-list (build-path r-data "data"))) string<?)
                (sort (for/list ([shape (in-list shapes)]) (format "~a.rktd.gz" (car shape))) string<?))

  (check-equal? (for/list ([name (in-list '("species" "island" "bill-length-mm" "bill-depth-mm"
                                            "flipper-length-mm" "body-mass-g" "sex" "year"))])
                  (cell 'penguins name 0))
                '("Adelie" "Torgersen" 39.1 18.7 181 3750 "male" 2007))
  (for ([name (in-list '("bill-length-mm" "bill-depth-mm" "flipper-length-mm" "body-mass-g" "sex"))])
    (check-true (dataset-missing? (cell 'penguins name 3))))
  (check-equal? (cell 'penguins "species" 343) "Chinstrap")
  (check-equal? (cell 'penguins "bill-length-mm" 343) 50.2)
  (check-equal? (missing-count 'penguins "bill-length-mm") 2)
  (check-equal? (missing-count 'penguins "sex") 11)
  (check-equal? (for/sum ([v (in-vector (column 'penguins "body-mass-g"))] #:unless (dataset-missing? v)) v)
                1437000)
  (check-equal? (for/list ([s (in-list '("Adelie" "Chinstrap" "Gentoo"))])
                  (for/sum ([v (in-vector (column 'penguins "species"))]) (if (equal? v s) 1 0)))
                '(152 68 124))
  (check-equal? (column-meta 'penguins "species" "levels")
                '("Adelie" "Chinstrap" "Gentoo"))
  (check-equal? (hash-ref (dataset-info 'penguins) "suggested-targets") '("species"))

  (check-equal? (cell 'penguins-raw "study-name" 0) "PAL0708")
  (check-equal? (cell 'penguins-raw "date-egg" 0) "2007-11-11")
  (check-equal? (cell 'penguins-raw "comments" 0) "Not enough blood for isotopes.")
  (check-equal? (cell 'penguins-raw "delta-15-n" 1) 8.94956)
  (check-equal? (cell 'penguins-raw "delta-13-c" 1) -24.69454)
  (check-equal? (cell 'penguins-raw "individual-id" 343) "N100A2")
  (check-equal? (cell 'penguins-raw "species" 343) "Chinstrap penguin (Pygoscelis antarctica)")
  (check-equal? (map (lambda (name) (missing-count 'penguins-raw name)) '("delta-15-n" "delta-13-c" "comments"))
                '(14 13 290))
  (check-equal? (column-meta 'penguins-raw "delta-15-n" "original-name")
                "Delta 15 N (o/oo)")

  (check-equal? (for/list ([name (in-list '("country" "continent" "year" "life-exp" "pop" "gdp-percap"))])
                  (list (cell 'gapminder name 0) (cell 'gapminder name 1703)))
                '(("Afghanistan" "Zimbabwe") ("Asia" "Africa") (1952 2007) (28.801 43.487)
                  (8425333 12311143) (779.4453145 469.7092981)))
  (check-equal? (for/sum ([v (in-vector (column 'gapminder "pop"))]) v) 50440465801)
  (check-equal? (length (column-meta 'gapminder "country" "levels")) 142)
  (check-equal? (column-meta 'gapminder "continent" "levels")
                '("Africa" "Americas" "Asia" "Europe" "Oceania"))
  (check-equal? (hash-ref (dataset-info 'gapminder) "suggested-targets") '("life-exp"))

  (check-equal? (map (lambda (name) (cell 'datasaurus-dozen name 0)) '("dataset" "x" "y"))
                '("dino" 55.3846 97.1795))
  (check-equal? (map (lambda (name) (cell 'datasaurus-dozen name 1845)) '("dataset" "x" "y"))
                '("wide_lines" 34.5838289299 89.5889019877))
  (check-= (for/sum ([v (in-vector (column 'datasaurus-dozen "x"))]) v) 100174.47351619641 1e-6)
  (for ([level (in-list (column-meta 'datasaurus-dozen "dataset" "levels"))])
    (check-equal? (for/sum ([v (in-vector (column 'datasaurus-dozen "dataset"))]) (if (equal? v level) 1 0))
                  142))

  (check-equal? (for/list ([name (in-list '("passenger-id" "survived" "pclass" "name" "sex" "age"
                                            "sib-sp" "parch" "ticket" "fare" "embarked"))])
                  (cell 'titanic-passengers name 0))
                '(1 0 3 "Braund, Mr. Owen Harris" "male" 22 1 0 "A/5 21171" 7.25 "S"))
  (check-true (dataset-missing? (cell 'titanic-passengers "cabin" 0)))
  (check-equal? (cell 'titanic-passengers "cabin" 1) "C85")
  (check-equal? (cell 'titanic-passengers "fare" 1) 71.2833)
  (check-equal? (cell 'titanic-passengers "name" 890) "Dooley, Mr. Patrick")
  (check-equal? (cell 'titanic-passengers "ticket" 890) "370376")
  (check-equal? (map (lambda (name) (missing-count 'titanic-passengers name)) '("age" "cabin" "embarked"))
                '(177 687 2))
  (check-equal? (for/sum ([v (in-vector (column 'titanic-passengers "survived"))]) v) 342)
  (check-= (for/sum ([v (in-vector (column 'titanic-passengers "fare"))]) v) 28693.9493 1e-6)
  (define titanic-info (dataset-info 'titanic-passengers))
  (check-equal? (hash-ref titanic-info "identifiers") '("passenger-id"))
  (check-equal? (hash-ref titanic-info "suggested-targets") '("survived"))
  (check-equal? (column-meta 'titanic-passengers "passenger-id" "original-name") "PassengerId"))
