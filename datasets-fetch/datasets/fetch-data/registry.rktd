          ("sha256" . "1a000a767f2ab1a5d20ba5ecaa48b625073dac568ed247afe400a0ac684ded5d")
          ("license" . "NOASSERTION")
          ("citation" . "Cohen, G., Afshar, S., Tapson, J. and van Schaik, A. (2017). EMNIST: an extension of MNIST to handwritten letters. arXiv:1702.05373.")
          ("notes" . "Downloads 561.8 MB (gzip.zip, which holds all six EMNIST splits; emnist-balanced, emnist-letters and emnist-digits each download it) and converts the letters split to one row per 28 x 28 grayscale image: the 124,800 training images, then the 20,800 test images, in file order, as torchvision's EMNIST with split=\"letters\" and train=True then train=False. Pixels are pixel1 to pixel784 in row-major order as stored, untransposed as torchvision and TensorFlow Datasets read them: each image is the transpose of the upright character. License NOASSERTION: NIST states no terms and asks that Cohen et al. (2017) be cited; the archive is fetched for use and never redistributed.")
          ("time-series" . #f)
          ("tier" . "fetch")
          ("package" . "datasets-fetch")
