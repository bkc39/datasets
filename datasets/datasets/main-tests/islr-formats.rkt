#lang racket/base
(require (prefix-in df: (only-in data-frame df-ref df-row-count))
         (only-in datasets dataset-missing dataset-missing? dataset-names
                  dataset-table-column dataset-table-names dataset-table-row-count load-dataset)
         (only-in datasets/data-frame data-frame-column-names)
         (only-in datasets/islr-tests/columns column-names)
         (only-in math/matrix matrix-num-cols matrix-num-rows matrix-ref)
         (prefix-in pl: (only-in polars dataframe-column dataframe-column-names polars-null?
                                 series-ref shape))
         (only-in racket/match match-define))
(module+ test
  (require (only-in rackunit check-= check-equal? check-true))
  (define cells
    `((auto ("name" 0 "chevrolet chevelle malibu") ("mpg" 391 31))
      (bikeshare ("hr" 1 "1") ("bikers" 0 16))
      (boston ("medv" 505 11.9))
      (brain-cancer ("diagnosis" 0 "Meningioma") ("time" 0 57.64))
      (caravan ("purchase" 0 "No"))
      (carseats ("shelve-loc" 0 "Bad") ("sales" 0 9.5))
      (college ("name" 0 "Abilene Christian University"))
      (credit ("region" 0 "South"))
      (default ("default" 0 "No") ("student" 1 "Yes"))
      (fund ("manager1" 0 -3.3419922473964618))
      (hitters ("player" 0 "-Andy Allanson") ("salary" 0 ,dataset-missing) ("salary" 1 475))
      (khan ("split" 82 "test") ("gene-1" 0 0.7733437))
      (nci60 ("label" 0 "CNS") ("gene-6830" 63 1.21))
      (nyse ("date" 0 "1962-12-03") ("day-of-week" 1 "tues") ("train" 6050 0))
      (oj ("purchase" 3 "MM"))
      (ozone ("ozone" 82 95.9999999999999) ("wind" 33 4.0))
      (portfolio ("x" 0 -0.89525088914155693))
      (prostate ("split" 0 "train") ("lpsa" 96 5.5829322))
      (publication ("mech" 0 "R01"))
      (sa-heart ("famhist" 0 "Present") ("chd" 461 1))
      (smarket ("direction" 0 "Up"))
      (vowel ("split" 989 "test") ("y" 989 11))
      (wage ("education" 0 "1. < HS Grad") ("wage" 0 75.04315401735154))
      (weekly ("direction" 0 "Down"))))
  (define (polars-value frame name row) (pl:series-ref (pl:dataframe-column frame name) row))
  (define (numeric-columns id)
    (column-names id (lambda (meta)
                       (and (member (hash-ref meta "type") '("integer" "real"))
                            (zero? (hash-ref meta "missing-count"))))))

  (check-equal? (map car cells) (dataset-names #:package "datasets-islr"))
  (for ([c (in-list cells)])
    (match-define (cons id spots) c)
    (define table (load-dataset id #:format 'table))
    (define names (dataset-table-names table))
    (define rows (dataset-table-row-count table))
    (define frame (load-dataset id))
    (define df (load-dataset id #:format 'data-frame))
    (define columns (numeric-columns id))
    (define matrix (load-dataset id #:format 'matrix #:columns columns))
    (check-equal? (pl:shape frame) (list rows (length names)))
    (check-equal? (pl:dataframe-column-names frame) names)
    (check-equal? (df:df-row-count df) rows)
    (check-equal? (data-frame-column-names df) names)
    (check-equal? (list (matrix-num-rows matrix) (matrix-num-cols matrix))
                  (list rows (length columns)))
    (for ([name (in-list columns)] [j (in-naturals)])
      (check-equal? (matrix-ref matrix (sub1 rows) j)
                    (vector-ref (dataset-table-column table name) (sub1 rows))))
    (for ([spot (in-list spots)])
      (match-define (list name row value) spot)
      (define polars (polars-value frame name row))
      (check-equal? (vector-ref (dataset-table-column table name) row) value)
      (check-equal? (df:df-ref df row name) value)
      (cond [(dataset-missing? value) (check-true (pl:polars-null? polars))]
            [(number? value) (check-= polars value 0)]
            [else (check-equal? polars value)]))))
